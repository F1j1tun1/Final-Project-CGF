{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "desktop",
      "displayName": "Desktop game + tests (system compiler)",
      "binaryDir": "${sourceDir}/build/desktop",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON", "BJ_BUILD_APP": "ON" }
    },
    {
      "name": "core-only",
      "displayName": "Game rules + tests, no graphics dependencies",
      "binaryDir": "${sourceDir}/build/core",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON", "BJ_BUILD_APP": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "desktop", "configurePreset": "desktop", "configuration": "Debug" },
    { "name": "core-only", "configurePreset": "core-only", "configuration": "Debug" }
  ],
  "testPresets": [
    { "name": "desktop", "configurePreset": "desktop", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "core-only", "configurePreset": "core-only", "configuration": "Debug", "output": { "outputOnFailure": true } }
  ]
}
